        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"statement\": \"CREATE CONSTRAINT ent_nombre IF NOT EXISTS FOR (e:Entidad) REQUIRE e.nombre IS UNIQUE\"\n}",

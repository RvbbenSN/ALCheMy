        }
      },
      "id": "72e432ea-8e1f-4b61-824e-73f3414ed974",
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [
        680,
        660
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://TU-INSTANCIA.databases.neo4j.io/db/neo4j/query/v2",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"statement\": \"UNWIND $nodos AS n MERGE (e:Entidad {nombre: n.nombre}) SET e.tipo = n.tipo WITH count(*) AS _ UNWIND $rels AS r MATCH (a:Entidad {nombre: r.origen}), (b:Entidad {nombre: r.destino}) MERGE (a)-[x:REL {tipo: r.tipo}]->(b) RETURN count(x) AS creadas\",\n  \"parameters\": {\n    \"nodos\": {{ JSON.stringify($json.output.nodos) }},\n    \"rels\": {{ JSON.stringify($json.output.relaciones) }}\n  }\n}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        },
        "options": {}
      },
      "id": "fb80b9a3-8b66-4830-8e85-1a9b22aae44c",

    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "76222814-9a06-414d-a5be-27fd6ea6069e",
              "name": "texto",
              "type": "string",
              "value": "=YayaFit es un gimnasio para personas mayores. La clase de Aquagym y la clase de Paseo saludable se hacen al aire libre; la Gimnasia suave, el Pilates para mayores y Fuerza y equilibrio se hacen en sala climatizada. El calor afecta a Aquagym y a Paseo saludable. La socia Carmen Ruiz, de 84 anos e hipertensa, asiste a Aquagym y a Gimnasia suave. La socia Pilar Ibanez, de 78 anos con cardiopatia, asiste a Aquagym y a Paseo saludable. La socia Josefa Moreno, de 81 anos, asiste a Paseo saludable. El socio Antonio Gil asiste a Pilates y a Fuerza y equilibrio. La socia Remedios Vega asiste a Gimnasia suave. La Piscina Municipal El Pinar cede la piscina para el Aquagym y es proveedor unico. El Protocolo de calor aplica a Aquagym y a Paseo saludable y obliga a avisar con 24 horas. La incidencia del mareo de julio de 2025 afecta a Carmen Ruiz."
            }
          ]
        },
        "options": {}
      },
      "id": "bad732a0-5c3a-47a4-881e-985ba9605b4e",
      "name": "Texto del caso YayaFit",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        420,
        420
      ]
    },
    {
      "parameters": {
        "text": "={{ $json.texto }}",
        "attributes": {
          "attributes": [
            {
              "name": "nodos",
              "description": "Lista de entidades. Cada una con: nombre y tipo (Socia, Clase, Instalacion, Riesgo, Protocolo, Incidencia)",
              "required": true
            },
            {
              "name": "relaciones",
              "description": "Lista de relaciones. Cada una con: origen, tipo (ASISTE_A, AL_AIRE_LIBRE, AFECTA_A, CEDE, APLICA_A, IMPLICA) y destino",
              "required": true
            }
          ]
        },
        "options": {}
      },
      "id": "9045f43b-fb3b-4c36-ac72-025861a10404",
      "name": "Extraer entidades y relaciones",
      "type": "@n8n/n8n-nodes-langchain.informationExtractor",
      "typeVersion": 1,
      "position": [
        680,
        420
      ]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4o-mini",
          "cachedResultName": "gpt-4o-mini"
        },
        "options": {

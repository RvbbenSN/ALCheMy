      "typeVersion": 2.2,
      "position": [
        -20,
        -60
      ],
      "id": "Esta_encendido",
      "name": "Esta encendido"
    },
    {
      "parameters": {
        "content": "### El IF de tres lineas\nEsto es lo que hay que copiar y pegar **al principio de cada workflow** del proyecto.\n\nRama falsa → `Parada en seco`, y el flujo termina.\nRama verdadera → sigue como siempre.",
        "height": 200,
        "width": 380,
        "color": 3
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -60,
        -320
      ],
      "id": "N_if",
      "name": "N_if"
    },
    {
      "parameters": {},
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        200,
        80
      ],
      "id": "Parada_en_seco",
      "name": "Parada en seco"
    },
    {
      "parameters": {
        "jsCode": "// ============================================================\n// CORTACIRCUITOS · si fallan 3 ejecuciones seguidas, se apaga solo.\n// ============================================================\nconst control = $input.first().json;\nconst fallos = Number(control.fallos_consecutivos || 0);\nconst UMBRAL = 3;\n\nif (fallos >= UMBRAL) {\n  return [{ json: {\n    ...control,\n    accion_control: 'APAGAR',\n    aviso: 'Cortacircuitos disparado: ' + fallos + ' fallos consecutivos. El agente se desactiva.'\n  }}];\n}\nreturn [{ json: { ...control, accion_control: 'SEGUIR', aviso: '' } }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        200,
        -160
      ],
      "id": "Comprobar_el_cortacircuitos",
      "name": "Comprobar el cortacircuitos"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.accion_control }}",
              "rightValue": "APAGAR",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        420,
        -160
      ],
      "id": "Hay_que_apagar",
      "name": "Hay que apagar"
    },
    {

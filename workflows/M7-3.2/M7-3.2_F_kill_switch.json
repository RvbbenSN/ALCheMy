            {
              "keyName": "clave",
              "condition": "eq",
              "keyValue": "agente_briefing"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "position": [
        -240,
        -60
      ],
      "id": "Leer_el_control",
      "name": "Leer el control"
    },
    {

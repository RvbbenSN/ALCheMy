      "id": "Intencion",
      "name": "Intencion"
    },
    {
      "parameters": {
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "value": "matriz_permisos",
          "mode": "name"
        },
        "returnAll": true,
        "options": {}
      },
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "position": [
        360,
        -60
      ],
      "id": "Leer_la_matriz",
      "name": "Leer la matriz"
    },
    {
      "parameters": {
        "jsCode": "// El guardian, igual que en el workflow A pero devolviendo tambien el plazo.\nconst i = $('Intencion').first().json;\nconst reglas = $input.all().map(x => x.json);\nconst r = reglas.find(f => f.accion === i.accion);\nconst out = (v, m, ap, plazo) => [{ json: { ...i, veredicto: v, motivo: m, aprobador: ap || '', plazo_h: plazo || 0 } }];\n\nif (!r) return out('denegar', 'Accion desconocida: ' + i.accion);\nif (r.activa === false || r.activa === 'false') return out('denegar', 'Accion desactivada.');\nconst maxD = Number(r.max_destinos || 0);\nif (maxD > 0 && Number(i.destinatarios || 0) > maxD)\n  return out('denegar', 'Alcance excedido: ' + i.destinatarios + ' > ' + maxD + '.');\nconst minH = Number(r.antelacion_min_h || 0);\nif (minH > 0 && Number(i.antelacion_h || 0) < minH)\n  return out('denegar', 'Antelacion insuficiente: ' + i.antelacion_h + ' h < ' + minH + ' h.');\nif (r.nivel === 'L4' || r.nivel === 'L3') return out('permitir', 'Nivel ' + r.nivel + '.');\nif (r.nivel === 'L2') return out('pedir_ok', 'Nivel L2: requiere aprobacion.', r.aprobador, 2);\nreturn out('denegar', 'Nivel ' + r.nivel + ': no lo ejecuta el agente.');\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        580,
        -60
      ],
      "id": "Aplicar_la_politica",
      "name": "Aplicar la politica"
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "version": 2
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.veredicto }}",
                    "rightValue": "permitir",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "outputKey": "permitir"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "version": 2
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.veredicto }}",
                    "rightValue": "pedir_ok",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "outputKey": "pedir_ok"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "version": 2
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.veredicto }}",
                    "rightValue": "denegar",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "outputKey": "denegar"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        800,
        -60
      ],
      "id": "Que_hacemos",
      "name": "Que hacemos"
    },
    {
      "parameters": {
        "content": "## Carril 2 · APROBAR\nSolo entran aqui las acciones con veredicto `pedir_ok`.\n\n1. Se abre la fila en `aprobaciones` con estado PENDIENTE.\n2. Se manda la tarjeta con los dos enlaces.\n3. El Wait duerme la ejecucion hasta 2 h.\n4. Al volver, se mira `$json.query.decision`.\n\n**La rama `permitir` se salta este carril entero.**",
        "height": 240,
        "width": 520,
        "color": 3
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        1000,
        -520
      ],
      "id": "N_carril2",
      "name": "N_carril2"
    },
    {
      "parameters": {
        "operation": "insert",
        "dataTableId": {
          "__rl": true,
          "value": "aprobaciones",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "id_ejecucion": "={{ $execution.id }}",
            "cuando": "={{ $now.toISO() }}",
            "accion": "={{ $json.accion }}",
            "destinatarios": "={{ $json.destinatarios }}",
            "aprobador": "={{ $json.aprobador }}",
            "estado": "PENDIENTE",
            "decidido_en": "",
            "motivo_rechazo": ""
          }
        },
        "options": {}
      },
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "position": [
        1020,
        -180

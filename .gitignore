# Database Data Directories & Persistence (Ocultos de GitHub por Propiedad Intelectual)
# Anclados con "/" inicial a proposito: sin el, "data/" casa con CUALQUIER
# carpeta llamada data a cualquier profundidad, y se tragaba en silencio
# web/src/data/ (los datos de las figuras). El repositorio compilaba en local y
# habria fallado en cualquier clon nuevo, sin error visible al commitear.
/data/
/data/postgres/
/data/n8n/
/data/pgadmin/
/data/raw/*
!/data/raw/.gitkeep
/data/processed/*
!/data/processed/.gitkeep
/data/raw_datalake/*
!/data/raw_datalake/.gitkeep
!/data/sample_demo/

# Carpeta Privada de Metodología, Diario y Protocolos (OCULTA EN GITHUB)
methodology/
.agents/

# Material de marca en bruto: moodboards, audio, .docx del guion, logos fuente.
# Es material de trabajo, no producto. Lo publicable ya sale de aqui como
# artefacto: los tokens en web/src/styles/tokens.css (generados por
# scripts/build_design_tokens.py) y los favicons en web/public/.
design_system/

# Dependencias de Node (la app web se reconstruye con `npm install`)
node_modules/

# MCP config (contains n8n API key)
.mcp.json

# IDEs & System Files
.vscode/
.idea/
.claude/
*.swp
.DS_Store
Thumbs.db

# Backups Privados (Ocultos de GitHub)
backups/

# Scripts Temporales y Borradores de Trabajo (Scratch)
scratch/

# Exports sueltos de conversaciones con Claude (no son código del proyecto)
Conversacion con Claude*


